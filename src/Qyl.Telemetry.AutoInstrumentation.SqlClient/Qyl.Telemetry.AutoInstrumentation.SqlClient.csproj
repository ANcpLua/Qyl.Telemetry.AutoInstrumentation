<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Qyl.Telemetry.AutoInstrumentation</RootNamespace>
    <AssemblyName>Qyl.Telemetry.AutoInstrumentation.SqlClient</AssemblyName>
    <PackageId>Qyl.Telemetry.AutoInstrumentation.SqlClient</PackageId>
    <Description>Zero-code AOT-native Microsoft.Data.SqlClient DiagnosticSource instrumentation for qyl.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <!-- Microsoft.Data.SqlClient 7.1.1 brings .Pkcs 9.0.18 (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7);
         this floor reaches consumers through the nuspec. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Qyl.Telemetry.Integration.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="buildTransitive\Qyl.Telemetry.AutoInstrumentation.SqlClient.targets"
          Pack="true"
          PackagePath="buildTransitive\" />
    <None Include="buildTransitive\Qyl.Telemetry.AutoInstrumentation.SqlClient.Bootstrap.g.cs"
          Pack="true"
          PackagePath="buildTransitive\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Qyl.Telemetry.AutoInstrumentation\Qyl.Telemetry.AutoInstrumentation.csproj"
                      IncludeAssets="all"
                      PrivateAssets="none" />
    <ProjectReference Include="..\Qyl.Telemetry.AutoInstrumentation.DiagnosticListeners\Qyl.Telemetry.AutoInstrumentation.DiagnosticListeners.csproj" />
  </ItemGroup>

</Project>
