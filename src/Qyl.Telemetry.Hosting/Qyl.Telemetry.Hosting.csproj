<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- The consumer contract is the namespace and the one-liner: namespace Qyl,
         builder.AddQyl(). The package-family rename changed PackageId and AssemblyName only.
         Qyl.Sdk is retired; deprecated on nuget.org with alternate Qyl.Telemetry.Hosting. -->
    <RootNamespace>Qyl</RootNamespace>
    <AssemblyName>Qyl.Telemetry.Hosting</AssemblyName>
    <PackageId>Qyl.Telemetry.Hosting</PackageId>
    <Description>One-line qyl onboarding for .NET applications: builder.AddQyl() wires the OpenTelemetry SDK, qyl listeners, version-pinned GenAI, Azure SDK, MCP and CoreWCF sources, OTLP export with local collector discovery, and session-tag inheritance.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- The consumer guide for coding agents, at the package root next to README.md. -->
    <None Include="SKILL.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Qyl.Telemetry.Integration.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Qyl.Telemetry.AutoInstrumentation.Hosting\Qyl.Telemetry.AutoInstrumentation.Hosting.csproj"
                      IncludeAssets="all"
                      PrivateAssets="none" />
  </ItemGroup>

</Project>
